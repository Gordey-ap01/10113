# BEGIN Gordey_ap01 security baseline
Options -Indexes
<FilesMatch "(?i)^(wp-config[.]php|[.]env(?:[.].*)?|import-images2?[.]php|php[0-9]*[.]cgi|.*[.](?:sql(?:[.]gz)?|sqlite3?|key|pem|p12|pfx|bak))$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
php_flag session.upload_progress.enabled Off
php_flag allow_url_include Off
php_flag display_errors Off
php_flag log_errors On
# END Gordey_ap01 security baseline

Options -Indexes -MultiViews
AddDefaultCharset UTF-8

RewriteEngine On
RewriteRule ^remont(?:/.*)?$ https://xn--101-eddot8cge.xn--p1ai/#contacts [R=302,L,NE]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always unset X-Powered-By
</IfModule>
